# Supabase project (Project Settings → API). Publishable key only; never commit a secret/service key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "supabase" = live data through /api/d4/* (default)
# "fixture"  = local preview with fictional in-memory data, no login (development only)
NEXT_PUBLIC_D4_DATA_MODE=supabase

# Only for scripts/seed-d4.mjs — an HR/MANAGER account of the test project. Keep in .env.local.
D4_SEED_EMAIL=
D4_SEED_PASSWORD=

# Fixture mode only: HR (default) | MANAGER | EMPLOYEE — previews role-based visibility.
NEXT_PUBLIC_D4_FIXTURE_ROLE=

# Optional: shows the "Kredensial Pengujian (Demo)" box on /login (B2 design). Demo/staging only —
# the values are public in the browser bundle, so use a dedicated demo account, never a real one.
NEXT_PUBLIC_D4_DEMO_EMAIL=
NEXT_PUBLIC_D4_DEMO_PASSWORD=
